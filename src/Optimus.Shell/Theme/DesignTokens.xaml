<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:vm="clr-namespace:Optimus.Shell.ViewModels">
    <!-- Refined Dark Palette -->
    <!-- Background: #0B111B -> #101114 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#101114" />
    <SolidColorBrush x:Key="BgBrush" Color="#101114" />

    <!-- Main surfaces: #111C2B -> #181A1F; raised surfaces #1A293C -> #20232A -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#181A1F" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#20232A" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#20232A" />

    <!-- Primary text: #EAF2FA -> #F1F2F4 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F2F4" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F2F4" />

    <!-- Secondary text: #A7B8CD -> #A3A9B5 -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A9B5" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#A3A9B5" />

    <!-- Accent: #7DD3FC -> #8C9EFF (periwinkle instead of sky blue) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8C9EFF" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#7080D9" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#101114" />

    <!-- Success: #30D158 -> keep but mute slightly (#34C759) -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#34C759" />
    <SolidColorBrush x:Key="SurfaceSuccessBrush" Color="#162419" />

    <!-- Error: #FF5555 -> keep but mute slightly (#E05353) -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#E05353" />
    <SolidColorBrush x:Key="SurfaceErrorBrush" Color="#2D1818" />

    <!-- Warning / Amber -->
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="SurfaceWarningBrush" Color="#2A2415" />

    <!-- Border: #34465C -> thin borders with subtle opacity -->
    <SolidColorBrush x:Key="BorderBrush" Color="#282C34" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#26FFFFFF" />

    <!-- Shadow -->
    <Color x:Key="DropShadowColor">#40000000</Color>

    <!-- Spacing scale: 4px base; 8, 12, 16, 24, 32px scale -->
    <sys:Double x:Key="SpacingBase">4</sys:Double>
    <sys:Double x:Key="SpacingXs">4</sys:Double>
    <sys:Double x:Key="SpacingSm">8</sys:Double>
    <sys:Double x:Key="SpacingMd">12</sys:Double>
    <sys:Double x:Key="SpacingLg">16</sys:Double>
    <sys:Double x:Key="SpacingXl">24</sys:Double>
    <sys:Double x:Key="SpacingXxl">32</sys:Double>

    <!-- Corners: 12px controls, 16px cards, fully rounded companion -->
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CompanionCornerRadius">24</CornerRadius>

    <!-- Motion: 160-240ms controls, 240-320ms panel transitions -->
    <Duration x:Key="ControlAnimationDuration">0:0:0.200</Duration>
    <Duration x:Key="PanelAnimationDuration">0:0:0.280</Duration>

    <!-- Common Converters -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <vm:InverseBooleanConverter x:Key="InverseBool" />

    <!-- Capsule toggle button style (for mic/mute toggles) -->
    <Style x:Key="CapsuleToggle" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CardCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
