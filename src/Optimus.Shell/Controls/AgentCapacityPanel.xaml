<UserControl x:Class="Optimus.Shell.Controls.AgentCapacityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Optimus.Shell.Controls"
             Height="Auto"
             HorizontalAlignment="Stretch">
    <Border Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,9">
        <StackPanel>
            <TextBlock Text="AGENT CAPACITY"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,7" />
            <ItemsControl ItemsSource="{Binding Agents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:BatteryBar AgentName="{Binding Name}"
                                          CapacityPercent="{Binding CapacityPercent}"
                                          IsLow="{Binding IsLow}"
                                          Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
