<Window x:Class="Optimus.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Optimus.Shell.ViewModels"
        xmlns:ctrl="clr-namespace:Optimus.Shell.Controls"
        xmlns:core="clr-namespace:Optimus.Core.Narration;assembly=Optimus.Core"
        xmlns:theme="clr-namespace:Optimus.Shell.Theme"
        mc:Ignorable="d"
        Title="Optimus Voice OS"
        FontFamily="Segoe UI"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseDown="OnWindowMouseDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <vm:InverseBooleanConverter x:Key="InverseBool" />

            <!-- Capsule button style -->
            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Capsule toggle button style (for mic/mute toggles) -->
            <Style x:Key="CapsuleToggle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CardCornerRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="{StaticResource CompanionCornerRadius}"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="2"
                              Opacity="0.25"
                              Color="{StaticResource DropShadowColor}" />
        </Border.Effect>

        <StackPanel>
            <!-- ══════════════════════════════════════════════════════════
                 COLLAPSED CAPSULE: Orb + State label + Destination + Mic toggle + Expand
                 ~280x64px
                 ══════════════════════════════════════════════════════════ -->
            <Grid MinWidth="280" Height="64" Margin="8,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- Orb -->
                    <ColumnDefinition Width="Auto" />  <!-- State label -->
                    <ColumnDefinition Width="*" />      <!-- Destination -->
                    <ColumnDefinition Width="Auto" />  <!-- Mic toggle -->
                    <ColumnDefinition Width="Auto" />  <!-- Expand toggle -->
                </Grid.ColumnDefinitions>

                <!-- Animated orb -->
                <ctrl:VoiceOrb x:Name="Orb" Grid.Column="0"
                               WidgetState="{Binding State}"
                               MicEnergy="{Binding MicEnergy}"
                               PlaybackEnergy="{Binding PlaybackEnergy}"
                               IsSpeakingReview="{Binding IsSpeakingReview}"
                               IsSessionOpen="{Binding IsSessionOpen}"
                               IsPaused="{Binding IsPaused}"
                               IsMuted="{Binding IsSpeechMuted}"
                               VerticalAlignment="Center"
                               Margin="4,0,8,0" />

                <!-- State label -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding OrbLabel, ElementName=Orb}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding StatusLine}"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryBrush}"
                               MaxWidth="120"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Locked destination display -->
                <Border Grid.Column="2" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,4"
                        Margin="0,0,6,0"
                        ToolTip="Locked voice destination · Tap expand to switch">
                    <TextBlock Text="{Binding ShortDestinationLabel}"
                               FontSize="10"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="100" />
                </Border>

                <!-- Microphone toggle -->
                <Button Grid.Column="3" Style="{StaticResource CapsuleToggle}"
                        Background="{StaticResource RaisedBrush}"
                        Command="{Binding TogglePauseCommand}"
                        VerticalAlignment="Center"
                        ToolTip="Pause / resume listening"
                        Margin="0,0,4,0">
                    <TextBlock FontSize="14" Foreground="{StaticResource TextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="🎙" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Text" Value="🔇" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Expand/collapse toggle -->
                <Button Grid.Column="4" Style="{StaticResource CapsuleToggle}"
                        Background="{StaticResource RaisedBrush}"
                        Command="{Binding ToggleExpandedCommand}"
                        VerticalAlignment="Center"
                        ToolTip="Expand / collapse"
                        Margin="0,0,4,0">
                    <TextBlock FontSize="12" Foreground="{StaticResource SecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="▼" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="▲" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 EXPANDED PANEL: ~400px wide, content-driven height
                 ══════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                    Width="400"
                    Margin="0,4,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,24,24"
                    Padding="16,8,16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled"
                               MaxHeight="480">
                    <StackPanel>

                        <!-- Session badge -->
                        <Border Background="{StaticResource SurfaceSuccessBrush}" CornerRadius="8" Padding="9,5"
                                HorizontalAlignment="Left" Margin="0,0,0,8"
                                Visibility="{Binding IsSessionOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding SessionBadgeColor, FallbackValue={x:Static theme:DesignTokens.SuccessHex}}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding SessionBadgeText}" FontSize="10"
                                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Recent transcript (raw) -->
                        <StackPanel Visibility="{Binding HasRawTranscript, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,8">
                            <TextBlock Text="TRANSCRIPT" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,3" />
                            <Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="10,6">
                                <TextBlock Text="{Binding RawTranscript}" FontSize="11"
                                           Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" MaxHeight="60" />
                            </Border>
                        </StackPanel>

                        <!-- Assistant response card -->
                        <Border Visibility="{Binding HasAssistantResponse, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource RaisedBrush}" CornerRadius="10"
                                Padding="12,8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding AssistantResponseHeadline, FallbackValue='ASSISTANT RESPONSE'}"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                                    <Button Content="Clear" Command="{Binding ClearAssistantResponseCommand}"
                                            HorizontalAlignment="Right" Padding="6,1"
                                            Background="Transparent" Foreground="{StaticResource SecondaryBrush}"
                                            BorderThickness="0" FontSize="9" />
                                </Grid>
                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding AssistantResponseText}" FontSize="12"
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                               LineHeight="18" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Assistant response / draft review card -->
                        <Border Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource RaisedBrush}" CornerRadius="10"
                                Padding="12,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="YOUR PROMPT" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,4" />
                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding DraftText}" FontSize="13"
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                               LineHeight="20" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Confirmation instructions -->
                        <TextBlock Text="Say send · redictate · cancel" FontSize="12"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"
                                   Visibility="{Binding IsConfirmPanelVisible, Converter={StaticResource BoolToVis}}" />

                        <!-- Error message -->
                        <Border Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,8" Background="{StaticResource SurfaceErrorBrush}"
                                BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Dismiss"
                                        Command="{Binding DismissErrorCommand}"
                                        Margin="8,0,0,0" Padding="6,2"
                                        Background="{StaticResource ErrorBrush}" Foreground="{StaticResource TextBrush}"
                                        BorderThickness="0" FontSize="10" />
                            </Grid>
                        </Border>

                        <!-- Narration status -->
                        <TextBlock Text="{Binding NarrationStatus}" FontSize="10"
                                   Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"
                                   MaxHeight="50" Margin="0,0,0,6"
                                   Visibility="{Binding HasNarrationStatus, Converter={StaticResource BoolToVis}}" />

                        <!-- Pending decision / approval card -->
                        <Border Visibility="{Binding HasPendingDecision, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource RaisedBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DecisionTitle}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DecisionSubtitle}"
                                               FontSize="9" Foreground="{StaticResource SecondaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding DecisionDescription}"
                                           FontSize="12" Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" LineHeight="18" Margin="0,2,0,8" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1" Content="{Binding DecisionSecondaryLabel}"
                                            Command="{Binding RejectDecisionCommand}"
                                            Margin="0,0,6,0" Padding="10,4"
                                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                                            BorderThickness="0" FontSize="11" />
                                    <Button Grid.Column="2" Content="{Binding DecisionPrimaryLabel}"
                                            Command="{Binding ApproveDecisionCommand}"
                                            Padding="10,4"
                                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                                            BorderThickness="0" FontSize="11" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Draft review actions: Cancel, Redictate, Confirm & Send -->
                        <Grid Visibility="{Binding IsConfirmPanelVisible, Converter={StaticResource BoolToVis}}"
                              Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DestinationName, StringFormat='→ {0}'}"
                                       Foreground="{StaticResource AccentBrush}" FontSize="11"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    Margin="4,0" Padding="8,3"
                                    Background="{StaticResource RaisedBrush}"
                                    Foreground="{StaticResource TextBrush}"
                                    BorderThickness="0" FontSize="10" />
                            <Button Grid.Column="2" Content="Redictate"
                                    Command="{Binding RedictateCommand}"
                                    Margin="0,0,4,0" Padding="8,3"
                                    Background="{StaticResource RaisedBrush}"
                                    Foreground="{StaticResource WarningBrush}"
                                    BorderThickness="0" FontSize="10" />
                            <Button Grid.Column="3" Content="Confirm &amp; Send"
                                    Command="{Binding ConfirmCommand}"
                                    Padding="8,3"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="{StaticResource OnAccentBrush}"
                                    BorderThickness="0" FontSize="10" FontWeight="SemiBold" />
                        </Grid>

                        <!-- Destination switcher -->
                        <StackPanel Margin="0,0,0,8">
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="DESTINATION" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Left" />
                                <Button Content="Refresh" Command="{Binding RefreshDestinationsCommand}"
                                        HorizontalAlignment="Right" Padding="6,1"
                                        Background="{StaticResource RaisedBrush}"
                                        Foreground="{StaticResource SecondaryBrush}"
                                        BorderThickness="0" FontSize="9" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Destinations}"
                                     SelectedItem="{Binding SelectedDestination}"
                                     Background="{StaticResource RaisedBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     Foreground="{StaticResource TextBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{Binding StatusColor}" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource SecondaryBrush}"
                                                       FontSize="9" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="200" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Window binding (conditional) -->
                            <StackPanel Visibility="{Binding NeedsWindowChoice, Converter={StaticResource BoolToVis}}"
                                        Margin="0,6,0,0">
                                <TextBlock Text="PICK THE EXACT WINDOW" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}" Margin="0,0,0,2" />
                                <ListBox ItemsSource="{Binding WindowChoices}"
                                         SelectedItem="{Binding SelectedWindowChoice}"
                                         Background="{StaticResource RaisedBrush}"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                         MaxHeight="80" FontSize="10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Bind to this window"
                                        Command="{Binding BindWindowCommand}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2"
                                        Background="{StaticResource WarningBrush}" Foreground="{StaticResource BackgroundBrush}"
                                        BorderThickness="0" FontSize="10" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Expanded details (cleanup, draft editing, latencies, narration) -->
                        <Expander Header="Details &amp; controls" IsExpanded="{Binding ShowDetails}"
                                  Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,8">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox Content="Clean up dictation" IsChecked="{Binding CleanupEnabled}"
                                          Foreground="{StaticResource TextBrush}" />
                                <CheckBox Content="Short review (destination only)" IsChecked="{Binding ShortReview}"
                                          Foreground="{StaticResource TextBrush}" />

                                <!-- Editable draft -->
                                <StackPanel Visibility="{Binding IsDraftVisible, Converter={StaticResource BoolToVis}}"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="PROMPT (editable)" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13" Foreground="{StaticResource TextBrush}"
                                             Background="{StaticResource RaisedBrush}"
                                             BorderBrush="{StaticResource AccentBrush}"
                                             BorderThickness="1" Padding="8,5"
                                             MinHeight="46" MaxHeight="120"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             CaretBrush="{StaticResource TextBrush}"
                                             IsReadOnly="{Binding IsDraftEditable, Converter={StaticResource InverseBool}}" />
                                </StackPanel>

                                <!-- Stage timings -->
                                <TextBlock Visibility="{Binding HasStageTimings, Converter={StaticResource BoolToVis}}"
                                           Text="{Binding StageTimings}" FontSize="10"
                                           FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />

                                <!-- Speech status -->
                                <StackPanel Visibility="{Binding HasSpeechStatus, Converter={StaticResource BoolToVis}}"
                                            Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="🔊" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSpeakingReview, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding SpeechStatus}" FontSize="10"
                                               FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap" MaxWidth="340" />
                                </StackPanel>

                                <!-- Agent narration controls -->
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="AGENT NARRATION" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <ComboBox SelectedValue="{Binding NarrationMode}"
                                                  SelectedValuePath="Tag" Width="130">
                                            <ComboBoxItem Content="Concise" Tag="{x:Static core:NarrationMode.Concise}" />
                                            <ComboBoxItem Content="Comprehensive" Tag="{x:Static core:NarrationMode.Comprehensive}" />
                                        </ComboBox>
                                        <CheckBox Content="Narrate tools &amp; skills"
                                                  IsChecked="{Binding NarrateToolsAndSkills}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- ─── Controls row: Pause · Mute · End ─── -->
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="10"
                                Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Pause listening -->
                                <Button Grid.Column="0" Command="{Binding TogglePauseCommand}"
                                        Background="Transparent" Padding="4,4" BorderThickness="0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" FontSize="16"
                                                   Foreground="{StaticResource TextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⏸" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Text" Value="▶" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="9" Foreground="{StaticResource SecondaryBrush}"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Pause" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Text" Value="Resume" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- Mute speech -->
                                <Button Grid.Column="1" Command="{Binding ToggleMuteCommand}"
                                        Background="Transparent" Padding="4,4" BorderThickness="0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" FontSize="16"
                                                   Foreground="{StaticResource TextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🔊" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpeechMuted}" Value="True">
                                                            <Setter Property="Text" Value="🔇" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="9" Foreground="{StaticResource SecondaryBrush}"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Mute" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpeechMuted}" Value="True">
                                                            <Setter Property="Text" Value="Unmute" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- End conversation -->
                                <Button Grid.Column="2" Command="{Binding EndConversationCommand}"
                                        Background="Transparent" Padding="4,4" BorderThickness="0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⏹" FontSize="16" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource ErrorBrush}" />
                                        <TextBlock Text="End" FontSize="9" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Open in AO -->
                        <Button Command="{Binding OpenInAoCommand}"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource RaisedBrush}"
                                Margin="0,0,0,8" Padding="10,7"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                ToolTip="Open Agent Orchestrator desktop or web dashboard">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Open in AO" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Footer: hotkey hint + phone status -->
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock FontSize="9" Foreground="{StaticResource SecondaryBrush}"
                                       Text="{Binding HotkeyLabel, StringFormat='Push-to-talk: {0} (hold to capture)'}" />
                            <TextBlock Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding PhoneStatus}" FontSize="9"
                                       FontFamily="Consolas" Foreground="{StaticResource SecondaryBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</Window>
