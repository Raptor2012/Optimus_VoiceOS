<Window x:Class="Optimus.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Optimus.Shell.ViewModels"
        xmlns:core="clr-namespace:Optimus.Core.Narration;assembly=Optimus.Core"
        mc:Ignorable="d"
        Title="Optimus Voice OS"
        FontFamily="Segoe UI"
        MinHeight="150"
        SizeToContent="Height"
        Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        MouseDown="OnWindowMouseDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBooleanConverter x:Key="InverseBool" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="14"
            Background="#0B111B"
            BorderBrush="#34465C"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.5"
                              Color="#000000" />
        </Border.Effect>

        <Grid Margin="18,16,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Status indicator dot, App title, State badge, Close button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Indicator Dot -->
                <Ellipse Grid.Column="0"
                         Width="10"
                         Height="10"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding StatusBadgeColor, FallbackValue='#30D158'}" />
                    </Ellipse.Fill>
                </Ellipse>

                <!-- App Title -->
                <TextBlock Grid.Column="1"
                           Text="OPTIMUS"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="#EAF2FA"
                           VerticalAlignment="Center" />

                <!-- State Badge -->
                <Border Grid.Column="2"
                        Margin="0,0,10,0"
                        CornerRadius="4"
                        Background="#1A293C"
                        Padding="6,2">
                    <TextBlock Text="{Binding State}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#7DD3FC" />
                </Border>

                <!-- Close / Hide Button -->
                <Button Grid.Column="3"
                        Content="✕"
                        Width="18"
                        Height="18"
                        MinHeight="18"
                        Padding="0"
                        Background="Transparent"
                        Foreground="#8E8E93"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCloseClick"
                        FontSize="10"
                        ToolTip="Close widget" />
            </Grid>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4" VerticalAlignment="Center">
                <!-- Status text -->
                <TextBlock Text="{Binding StatusLine}"
                           FontSize="13"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           MaxHeight="40"
                           TextTrimming="CharacterEllipsis" />

                <!-- Says plainly whether the microphone is open without a key held. -->
                <Border Background="#1B2E1F" CornerRadius="8" Padding="9,5" Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsSessionOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding SessionBadgeColor, FallbackValue='#30D158'}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding SessionBadgeText}" FontSize="10"
                                   Foreground="#8FE3A6" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#111C2B" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="DESTINATION" Foreground="#A7B8CD" FontSize="10" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding DestinationName}" Foreground="#7DD3FC" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="#111C2B" CornerRadius="10" Padding="12" Margin="0,8,0,0"
                        Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="YOUR PROMPT" Foreground="#A7B8CD" FontSize="10" Margin="0,0,0,6" />
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding DraftText}" Foreground="#EAF2FA" FontSize="14" TextWrapping="Wrap" LineHeight="21" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <TextBlock Text="Say send · redictate · cancel" Foreground="#7DD3FC" FontSize="12" Margin="0,10,0,0"
                           Visibility="{Binding IsConfirmPanelVisible, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF9C95" TextWrapping="Wrap" Margin="0,5,0,0"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding NarrationStatus}" Foreground="#A7B8CD" TextWrapping="Wrap" MaxHeight="65" Margin="0,5,0,0" />
                <Expander Header="Details &amp; controls" IsExpanded="{Binding ShowDetails}" Foreground="#AAAAAA" Margin="0,8,0,0">
                <StackPanel>
                <CheckBox Content="Clean up dictation" IsChecked="{Binding CleanupEnabled}" Foreground="#EEEEF5" />
                <CheckBox Content="Short review (destination only)" IsChecked="{Binding ShortReview}" Foreground="#EEEEF5" />
                <!-- Raw transcript, exactly as the speech model produced it -->
                <StackPanel Visibility="{Binding HasRawTranscript, Converter={StaticResource BoolToVis}}"
                            Margin="0,8,0,0">
                    <TextBlock Text="RAW TRANSCRIPT"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#636366"
                               Margin="0,0,0,2" />
                    <Border Background="#16161B"
                            CornerRadius="6"
                            Padding="8,5">
                        <TextBlock Text="{Binding RawTranscript}"
                                   FontSize="11"
                                   Foreground="#8E8E93"
                                   TextWrapping="Wrap"
                                   MaxHeight="70" />
                    </Border>
                </StackPanel>

                <!-- Cleaned draft, editable before confirmation -->
                <StackPanel Visibility="{Binding IsDraftVisible, Converter={StaticResource BoolToVis}}"
                            Margin="0,8,0,0">
                    <TextBlock Text="PROMPT (editable)"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#636366"
                               Margin="0,0,0,2" />
                    <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Foreground="#FFFFFF"
                             Background="#2C2C34"
                             BorderBrush="#0A84FF"
                             BorderThickness="1"
                             Padding="8,5"
                             MinHeight="46"
                             MaxHeight="120"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             CaretBrush="#FFFFFF"
                             IsReadOnly="{Binding IsDraftEditable, Converter={StaticResource InverseBool}}" />
                </StackPanel>

                <!-- Per-stage latency -->
                <TextBlock Visibility="{Binding HasStageTimings, Converter={StaticResource BoolToVis}}"
                           Text="{Binding StageTimings}"
                           FontSize="10"
                           FontFamily="Consolas"
                           Foreground="#5E9EFF"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <!-- Spoken review: reading indicator and measured speech latency -->
                <StackPanel Visibility="{Binding HasSpeechStatus, Converter={StaticResource BoolToVis}}"
                            Orientation="Horizontal"
                            Margin="0,4,0,0">
                    <TextBlock Text="🔊"
                               FontSize="10"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSpeakingReview, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding SpeechStatus}"
                               FontSize="10"
                               FontFamily="Consolas"
                               Foreground="#A78BFA"
                               TextWrapping="Wrap"
                               MaxWidth="360" />
                </StackPanel>

                <!-- Error panel if error state -->
                <Border Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                        Margin="0,4,0,0"
                        Background="#3A1E1E"
                        BorderBrush="#FF453A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ErrorMessage}"
                                   Foreground="#FF453A"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Dismiss"
                                Command="{Binding DismissErrorCommand}"
                                Margin="6,0,0,0"
                                Padding="6,2"
                                Background="#FF453A"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                FontSize="10"
                                Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Destination picker: always visible, always manual -->
                <StackPanel Margin="0,10,0,0">
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="DESTINATION"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#636366"
                                   HorizontalAlignment="Left" />
                        <Button Content="Refresh"
                                Command="{Binding RefreshDestinationsCommand}"
                                HorizontalAlignment="Right"
                                Padding="6,1"
                                Background="#2C2C34"
                                Foreground="#8E8E93"
                                BorderThickness="0"
                                FontSize="9"
                                Cursor="Hand" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Destinations}"
                             SelectedItem="{Binding SelectedDestination}"
                             Background="#16161B"
                             BorderBrush="#383842"
                             BorderThickness="1"
                             Foreground="#E5E5EA">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding StatusColor}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusDetail}"
                                               Foreground="#8E8E93"
                                               FontSize="9"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="220" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Window binding: shown only when a choice is actually required -->
                    <StackPanel Visibility="{Binding NeedsWindowChoice, Converter={StaticResource BoolToVis}}"
                                Margin="0,6,0,0">
                        <TextBlock Text="PICK THE EXACT WINDOW"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#FF9500"
                                   Margin="0,0,0,2" />
                        <ListBox ItemsSource="{Binding WindowChoices}"
                                 SelectedItem="{Binding SelectedWindowChoice}"
                                 Background="#16161B"
                                 Foreground="#E5E5EA"
                                 BorderBrush="#FF9500"
                                 BorderThickness="1"
                                 MaxHeight="80"
                                 FontSize="10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Bind to this window"
                                Command="{Binding BindWindowCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                Padding="8,2"
                                Background="#FF9500"
                                Foreground="#1E1E24"
                                BorderThickness="0"
                                FontSize="10"
                                Cursor="Hand" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="AGENT NARRATION" FontSize="9" FontWeight="SemiBold" Foreground="#636366" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <ComboBox SelectedValue="{Binding NarrationMode}" SelectedValuePath="Tag" Width="130">
                            <ComboBoxItem Content="Concise" Tag="{x:Static core:NarrationMode.Concise}" />
                            <ComboBoxItem Content="Comprehensive" Tag="{x:Static core:NarrationMode.Comprehensive}" />
                        </ComboBox>
                        <CheckBox Content="Narrate tools &amp; skills" IsChecked="{Binding NarrateToolsAndSkills}"
                                  Foreground="#E5E5EA" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding NarrationStatus}" FontSize="10" Foreground="#A78BFA"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding HasNarrationStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Confirm panel if confirm state -->
                <Grid Visibility="{Binding IsConfirmPanelVisible, Converter={StaticResource BoolToVis}}"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding DestinationName, StringFormat='→ {0}'}"
                               Foreground="#0A84FF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Margin="4,0"
                            Padding="8,2"
                            Background="#383842"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontSize="10"
                            Cursor="Hand" />
                    <Button Grid.Column="2"
                            Content="Confirm &amp; Send"
                            Command="{Binding ConfirmCommand}"
                            Padding="8,2"
                            Background="#0A84FF"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontSize="10"
                            Cursor="Hand" />
                </Grid>
                </StackPanel>
                </Expander>
            </StackPanel>
            </ScrollViewer>

            <!-- Footer: hotkey, and the phone endpoint address to dial -->
            <StackPanel Grid.Row="2" Margin="0,2,0,0">
                <TextBlock FontSize="10"
                           Foreground="#A7B8CD"
                           Text="{Binding HotkeyLabel, StringFormat='Push-to-talk: {0} (hold to capture)'}" />
                <TextBlock Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}"
                           Text="{Binding PhoneStatus}"
                           FontSize="10"
                           FontFamily="Consolas"
                           Foreground="#8E8E93"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
