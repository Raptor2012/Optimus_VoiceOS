<Window x:Class="Optimus.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Optimus.Shell.ViewModels"
        mc:Ignorable="d"
        Title="Optimus Voice OS"
        MinHeight="150"
        SizeToContent="Height"
        Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        MouseDown="OnWindowMouseDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="14"
            Background="#1E1E24"
            BorderBrush="#383842"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.5"
                              Color="#000000" />
        </Border.Effect>

        <Grid Margin="14,10,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Status indicator dot, App title, State badge, Close button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Indicator Dot -->
                <Ellipse Grid.Column="0"
                         Width="10"
                         Height="10"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding StatusBadgeColor, FallbackValue='#30D158'}" />
                    </Ellipse.Fill>
                </Ellipse>

                <!-- App Title -->
                <TextBlock Grid.Column="1"
                           Text="Optimus Voice"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#E5E5EA"
                           VerticalAlignment="Center" />

                <!-- State Badge -->
                <Border Grid.Column="2"
                        Margin="0,0,10,0"
                        CornerRadius="4"
                        Background="#2C2C34"
                        Padding="6,2">
                    <TextBlock Text="{Binding State}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#8E8E93" />
                </Border>

                <!-- Close / Hide Button -->
                <Button Grid.Column="3"
                        Content="✕"
                        Width="18"
                        Height="18"
                        Background="Transparent"
                        Foreground="#8E8E93"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCloseClick"
                        FontSize="10"
                        ToolTip="Close widget" />
            </Grid>

            <!-- Main Content Area -->
            <StackPanel Grid.Row="1" Margin="0,8,0,4" VerticalAlignment="Center">
                <!-- Status text -->
                <TextBlock Text="{Binding StatusLine}"
                           FontSize="13"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           MaxHeight="40"
                           TextTrimming="CharacterEllipsis" />

                <!-- Raw transcript, exactly as the speech model produced it -->
                <StackPanel Visibility="{Binding HasRawTranscript, Converter={StaticResource BoolToVis}}"
                            Margin="0,8,0,0">
                    <TextBlock Text="RAW TRANSCRIPT"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#636366"
                               Margin="0,0,0,2" />
                    <Border Background="#16161B"
                            CornerRadius="6"
                            Padding="8,5">
                        <TextBlock Text="{Binding RawTranscript}"
                                   FontSize="11"
                                   Foreground="#8E8E93"
                                   TextWrapping="Wrap"
                                   MaxHeight="70" />
                    </Border>
                </StackPanel>

                <!-- Cleaned draft, editable before confirmation -->
                <StackPanel Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}"
                            Margin="0,8,0,0">
                    <TextBlock Text="CLEANED DRAFT (editable)"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#636366"
                               Margin="0,0,0,2" />
                    <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Foreground="#FFFFFF"
                             Background="#2C2C34"
                             BorderBrush="#0A84FF"
                             BorderThickness="1"
                             Padding="8,5"
                             MinHeight="46"
                             MaxHeight="120"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             CaretBrush="#FFFFFF" />
                </StackPanel>

                <!-- Per-stage latency -->
                <TextBlock Visibility="{Binding HasStageTimings, Converter={StaticResource BoolToVis}}"
                           Text="{Binding StageTimings}"
                           FontSize="10"
                           FontFamily="Consolas"
                           Foreground="#5E9EFF"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <!-- Error panel if error state -->
                <Border Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                        Margin="0,4,0,0"
                        Background="#3A1E1E"
                        BorderBrush="#FF453A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ErrorMessage}"
                                   Foreground="#FF453A"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Dismiss"
                                Command="{Binding DismissErrorCommand}"
                                Margin="6,0,0,0"
                                Padding="6,2"
                                Background="#FF453A"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                FontSize="10"
                                Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Confirm panel if confirm state -->
                <Grid Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}"
                      Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding DestinationName, StringFormat='Destination: {0}'}"
                               Foreground="#0A84FF"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Margin="4,0"
                            Padding="8,2"
                            Background="#383842"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontSize="10" />
                    <Button Grid.Column="2"
                            Content="Confirm"
                            Command="{Binding ConfirmCommand}"
                            Padding="8,2"
                            Background="#0A84FF"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontSize="10" />
                </Grid>
            </StackPanel>

            <!-- Footer: Hotkey Info -->
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <TextBlock FontSize="10"
                           Foreground="#636366"
                           Text="{Binding HotkeyLabel, StringFormat='Push-to-talk: {0} (hold to capture)'}" />
            </Grid>
        </Grid>
    </Border>
</Window>
